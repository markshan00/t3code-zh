diff --git a/apps/web/src/v011DisplayStrings.ts b/apps/web/src/v011DisplayStrings.ts
new file mode 100644
index 00000000..3300a7b2
--- /dev/null
+++ b/apps/web/src/v011DisplayStrings.ts
@@ -0,0 +1,45 @@
+import { fillSlot, translateFixed } from "./newThreadDisplayStrings";
+import { fillDisplaySlots } from "./stableDisplayStrings";
+
+// All arguments remain raw data. Only fixed display fragments enter the dictionary.
+export function displayUsageAccountSummary(
+  account: string, remaining: number, resetsIn: string | null, timeLeft: number | null, credits: number,
+): string {
+  return `${account}: ${fillSlot("", String(remaining), "% left")}${resetsIn ? `, ${resetsIn}` : ""}${timeLeft === null ? "" : `, ${fillSlot("", String(timeLeft), "% of the window left")}`}${credits ? `, ${fillSlot("", String(credits), credits === 1 ? " reset credit banked" : " reset credits banked")}` : ""}`;
+}
+
+export function displayEasSessionLimits(sessions: number, minutes: number, idleMinutes: number): string {
+  return fillDisplaySlots(
+    sessions === 1
+      ? "Up to \uE000 session at once, each stopped after \uE001 min or \uE002 idle min"
+      : "Up to \uE000 sessions at once, each stopped after \uE001 min or \uE002 idle min",
+    [sessions, minutes, idleMinutes],
+  );
+}
+
+// Only the four numeric forms emitted by the local parseWebhookFilterDrafts validator.
+export function displayWebhookFilterError(value: string): string {
+  const limit = /^Use at most (\d+) filters\.$/.exec(value);
+  if (limit) return fillSlot("Use at most ", limit[1]!, " filters.");
+  const row = /^Filter (\d+) needs a path under body, headers or query(\.|, and at least one value\.|, and a value\.)$/.exec(value);
+  return row ? fillSlot("Filter ", row[1]!, ` needs a path under body, headers or query${row[2]}`) : value;
+}
+
+// These are the eight fixed pairs returned by webhookDeliveryLabel's local labels map.
+// Ordinary tuples keep the display literals out of the plugin's value-use pre-scan.
+const WEBHOOK_DELIVERY_STATUS_PAIRS: ReadonlyArray<readonly [string, string]> = [
+  ["dispatch_failed", "Run failed"],
+  ["duplicate", "Duplicate"],
+  ["coalesced", "Coalesced"],
+  ["filtered", "Filtered"],
+  ["rejected_signature", "Bad signature"],
+  ["disabled", "Task paused"],
+  ["rate_limited", "Rate limited"],
+  ["expired", "Too old"],
+];
+
+export function displayWebhookDeliveryStatus(outcome: string, label: string): string {
+  return WEBHOOK_DELIVERY_STATUS_PAIRS.some(
+    ([knownOutcome, knownLabel]) => outcome === knownOutcome && label === knownLabel,
+  ) ? translateFixed(label) : label;
+}
