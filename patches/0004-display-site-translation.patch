# 0004-display-site-translation.patch
#
# 显示位置补译：给那些同时被代码当作「值」比较/查表、因而转换插件不能包裹的界面文字
# 补一层只在渲染处生效的翻译。基线 v0.1.7，须在 0001 之后应用
# （依赖 0001 给 Window 补的 __t3zh 声明，本补丁把它扩上 t() 并补一个全局 var 声明）。
#
# 背景（handoff/T05.md「已知问题」第 2 条、dict/T05-changes.md §5.2）：有 16 条文字既被渲染、
# 又被代码当作值比较或用做查表键（例如 GitActionsControl 用 quickAction.label === "Commit"
# 选图标，Sidebar 用 THREAD_STATUS_PRIORITY[status.label] 排序）。CONVENTIONS §5 定案：
# 比较逻辑保持英文，只在显示位置调用 globalThis.__t3zh?.t?.(x) ?? x 翻译。可选链保证
# 没有汉化运行时（__t3zh 未挂载）时照常显示英文、不抛错；en 模式下 t 是恒等函数。
#
# 只改显示处（§5.3）：数据对象（`resolveChangeRequestTerminology` 的返回值、
# `getProviderSummary` 的 headline、右键菜单 item 的 label）保持英文原值，翻译放在消费方的
# JSX / title / placeholder / 菜单最终显示入口。带 `terminology.singular` 这类运行时拼接串的
# 显示文案，统一走 `sourceControlPresentation.tsx`（v0.1.3 由 .ts 改名）的 `localizeTerminologyText`：先按词库精确
# 命中整串，未命中再把术语替换成词库译文后才查表，好让整句落到词库既有的 `{request}` 模板上
# （§5.2、§5.4）。
#
# progress 行（服务端 `phase_started.label` 是任意非空串）改为**精确名单门控**（§5.1/§5.5）：
# `GitActionsControl.tsx` 里 `KNOWN_GIT_ACTION_PROGRESS` 是普通数组、传 `Set`；只有名单内的
# 13 个服务端 phase 值 + 2 个客户端值会查表，名单外（含 `Running <hook>...`）原样返回，
# 免得宽模板把 `Custom status` 之类改坏（`Custo 分 statu 秒`）。名单内每个值在主词库都有
# 精确 messages 词条（本次一并补入 dict/zh-CN.json）。
#
# 涉及 23 个上游文件（apps/web/src 下 20 个 + apps/desktop 1 个 + 1 个类型声明 +
# 1 个源控制文案）。r3 相比 r2 新增/改动的关键文件：
#   * components/GitActionsControl.tsx                 精确名单门控 progressLabel；快捷操作/菜单/默认分支对话框
#                                                      文案改走 localizeTerminologyText（原先 quickActionLabel 直接 t()）
#   * sourceControlPresentation.tsx                    localizeTerminologyText（整串优先、术语先行的受控替换）；不再预改 singular
#   * components/PullRequestThreadDialog.tsx（新）      对话框标题/说明/校验/占位符的 display 入口
#   * components/BranchToolbarBranchSelector.tsx（新）  Checkout {singular} 显示
#   * components/settings/{ProviderInstanceCard,CodexSetupSection}.tsx、onboarding/WelcomeWizard.tsx（新）
#                                                      provider headline 的 display 入口，走 providerStatusLabel
#   * components/settings/providerStatus.ts             headline 还原英文；新增 providerStatusLabel（只在渲染处翻）
#   * contextMenuFallback.ts（新）                      浏览器 DOM 右键菜单 label 的 display 入口
#   * apps/desktop/src/electron/ElectronMenu.ts（新）   桌面原生菜单 label 的 display 入口（__t3zh_t）
#
# r4 在 r3 显示入口上加了下述边界，避免再消费已经翻译过的文字或任意服务端/用户内容：
#   * providerStatusLabel 改为「静态 headline 精确名单 + 两个审核过的认证骨架」。英文骨架是
#     **兜底路径**：zh 模式下 headline 正常已在插件源头译好，helper 收到英文骨架说明该定义点
#     没被插件覆盖，此时用词库既有的 `Authenticated · {method}` / `Not authenticated · {0}`
#     模板翻译一次（词库这两条就是为此存在的，调度方 r5 裁决保留此设计）
#   * contextMenuFallback / ElectronMenu 的 displayMenuLabel 改为**只翻审核过、且有精确 messages
#     词条的菜单标签**（`TRANSLATABLE_MENU_LABELS`）；项目名、环境名、路径、分支名、
#     server 文案一律原样。`Branch` 因在 `SubagentTooltipContent` 里被当值比较，插件不包裹，
#     原生菜单是 Branch 在桌面端的翻译点；Copy path 在 v0.1.7 的 Sidebar
#     用对象 label 定义，网页插件已覆盖，原生入口使用实际大小写精确兜底。
#     两条词条因此也补进 dict/zh-CN.desktop.json
# 另有 components/GitActionsControl.logic.ts、threadActionMenu.logic.ts 的源头预翻译被移除：两文件
# 因此还原成上游原文，无 hunk，不占上面 23 个文件数（§5.3 的「只改显示处」落实结果）。
# 其余 r1 站点（Sidebar / Sidebar / ThreadStatusIndicators / RightPanelTabs /
# SubagentTooltipContent / PullRequestStackMenu / providerStatus 之外的 settings /
# ResourceTelemetryDiagnostics / UsagePriceOverrides / vite-env.d.ts）保持 r1 的显示处包法。
# T26（v0.1.3）：上游 #25401 删除 ComposerTasksBadge（任务步骤改为时间线行，步骤状态用符号），
# 其读屏状态 hunk 无后继显示入口，已退役；PullRequestStackMenu 的名词改由 terminology.singular /
# plural 提供（6 个内置值均有精确词条），同一显示处包裹跟到新表达式。
# T29 r1：只包悬浮提示里的术语；确认弹窗 DialogTitle 保持上游整句，由插件外层运行时按
# `Merge {0} pull requests?` 等模板整句翻译——内层预翻译术语会令模板失配（迁移时误加，已撤回）。
#
# r5（本轮）收紧三处边界：
#   * 认证骨架只接受「前缀精确相等 + 恰好一个 ` · ` 分隔符」（参数 = 剩余全部，可含换行）；
#     裸前缀无参数、参数里还有 ` · ` 的相似串（`Authenticated · x · y`）一律原样，不再走宽前缀
#   * `localizeTerminologyText` 的术语替换避开调用方给的 preserve 参数（providerName），
#     否则 providerName 里的同文本也会被当作术语换掉，原 providerName 不再逐字出现
#   * 菜单名单加 `Copy path`（两端一致），桌面词库补精确词条；动态项目子项仍原样，不恢复宽 t
#
# 未覆盖（补丁之外，handoff 中已记）：移动端 packages/client-runtime/state/gitActions.ts 与服务端
# GitManager 渲染同一批标签，属另一构建目标；`buildGitActionProgressStages` 的
# `Preparing <shortLabel>...` / `Generating <shortLabel> content...` / `Creating <singular>...`
# 在已知术语下与 13 个服务端 phase 是同一批字符串、已进名单，名单外的是 `Preparing feature ref...`
# 与带运行时推送目标的 `Pushing to <target>...`；Fast / New thread 按派单不改。
#
# 上游更新后重做方法见 patches/README.md。
diff --git a/apps/desktop/src/electron/ElectronMenu.ts b/apps/desktop/src/electron/ElectronMenu.ts
index d4338b45..dc0a3c2a 100644
--- a/apps/desktop/src/electron/ElectronMenu.ts
+++ b/apps/desktop/src/electron/ElectronMenu.ts
@@ -8,6 +8,52 @@ import * as Schema from "effect/Schema";

 import * as Electron from "electron";

+
+import { __t3zh_t } from "../t3zh/t3zh-desktop.ts";
+
+/**
+ * Audited fixed menu labels. "Branch" is also compared as a value in
+ * `chat/SubagentTooltipContent.tsx`, so the web plugin leaves it English.
+ * The v0.1.7 Sidebar defines `label: "Copy path"` inline, which the web plugin
+ * already translates. Keep its current spelling here as an exact-label
+ * fallback at the native boundary and in the DOM fallback. Already translated
+ * labels and arbitrary project, environment, path or branch values stay
+ * outside this allowlist.
+ * No template matching is used for labels outside the reviewed list.
+ *
+ * The same list appears in `apps/web/src/contextMenuFallback.ts`; the two must stay
+ * identical (asserted by `plugin/__tests__/display-site-translation.test.ts`) so
+ * "those fixed actions are translated on both ends, everything else is not" holds.
+ *
+ * Kept as a plain array passed to `Set` so the plugin's pre-scan does not record
+ * these literals as value-use (CONVENTIONS §5.5).
+ */
+const TRANSLATABLE_MENU_LABELS = [
+  // Right-click on a thread or a draft: the "Branch" entry under "Copy".
+  "Branch",
+  // Sidebar project menu: v0.1.7 uses the exact label "Copy path".
+  "Copy path",
+];
+const TRANSLATABLE_MENU_LABEL_SET = new Set(TRANSLATABLE_MENU_LABELS);
+
+/**
+ * t3code-zh (patches/0004-display-site-translation.patch): context-menu labels are
+ * built as value objects in the web app and cross IPC untranslated. This is the
+ * native menu's final display point; the selected `id` is unaffected. English
+ * when the main process resolves to en (the usual `__t3zh_t` contract).
+ *
+ * Only the audited labels above are handed to the translator. Everything else
+ * crossing IPC is data the user or the server owns — project names, workspace
+ * roots, branch names — and stays byte-for-byte, the same boundary the browser
+ * fallback uses. The desktop dictionary (`dict/zh-CN.desktop.json`) is also a
+ * different, much narrower file than the web one, so `/tmp/Custom status` stays
+ * unharmed here even though `__t3zh_t` would template-match it against the web
+ * dictionary; gating makes that independent of which dictionary is loaded.
+ */
+function displayMenuLabel(label: string): string {
+  if (!TRANSLATABLE_MENU_LABEL_SET.has(label)) return label;
+  return __t3zh_t(label);
+}
 export interface ElectronMenuPosition {
