+/**
+ * Added by patches/0004-display-site-translation.patch.
+ *
+ * `getProviderSummary` produces two families of headline:
+ *
+ * 1. A finite set of static English headlines. The plugin translates all of them
+ *    where they are defined *except* `Unavailable`, which doubles as a value
+ *    elsewhere in the app; whichever way it went, the value that reaches the
+ *    render site is either the audited English literal (translate it here) or an
+ *    already-translated string (leave it alone).
+ * 2. `Authenticated · ${authLabel}` / `Not authenticated · ${authLabel}`, whose
+ *    parameter is `provider.auth.label ?? provider.auth.type`. The contract types
+ *    it as any non-empty string (`packages/contracts/src/server.ts`), and
+ *    `AcpRegistryDriver` fills it with the auth method the server advertises — so
+ *    it is arbitrary server text, not a value this file knows.
+ *
+ * Handing the finished headline back to `t()` is what breaks family 2. An
+ * already-translated headline ("已认证 · Custom status") or one carrying a
+ * server string falls through the exact-message step and is caught by the
+ * dictionary's broad templates: "Custom status" → "Custo 分 statu 秒", and
+ * "已认证 · Custom status" → "已认证 · Custo 分 statu 秒".
+ *
+ * So the render site translates only what it can prove is a bare English
+ * skeleton: an exact value from the static set, or a headline whose English
+ * prefix is one of the two audited ones *and* which holds exactly one separator,
+ * so the parameter is the whole remaining tail (`Authenticated · <parameter>`,
+ * matching the dictionary's `Authenticated · {method}` / `Not authenticated ·
+ * {0}`). A second separator means the tail is not the single audited parameter
+ * this file knows how to split off — `Authenticated · x · y` is server text, not
+ * a skeleton — and a bare prefix with no parameter is not one either; both are
+ * returned byte-for-byte. The one lookup is accepted only when the parameter
+ * survives it verbatim, so a template that rewrote it would drop out here
+ * instead of shipping corrupted text. With no `__t3zh`, no `t`, or in en the
+ * original headline comes back unchanged.
+ */
+const STATIC_PROVIDER_HEADLINES = [
+  "Available",
+  "Unavailable",
+  "Disabled",
+  "Not found",
+  "Checking provider status",
+  "Needs attention",
+  "Authenticated",
+  "Not authenticated",
+];
+const STATIC_PROVIDER_HEADLINE_SET = new Set(STATIC_PROVIDER_HEADLINES);
+
+/** The two audited English auth skeletons, up to (and including) the separator. */
+const AUTH_HEADLINE_ENGLISH_PREFIXES = ["Authenticated · ", "Not authenticated · "];
+
+export function providerStatusLabel(headline: string): string {
+  const t = globalThis.__t3zh?.t;
+  if (!t) return headline;
+  // Only exact English members of the finite set reach `t()`, so an
+  // already-translated static headline (or an en-mode one) stays untouched.
+  if (STATIC_PROVIDER_HEADLINE_SET.has(headline)) return t(headline);
+  for (const prefix of AUTH_HEADLINE_ENGLISH_PREFIXES) {
+    if (!headline.startsWith(prefix)) continue;
+    // Exactly one separator: the parameter is the whole remaining tail. A tail
+    // that holds another ` · ` is a different (server-authored) string, not the
+    // audited skeleton, and is passed through untouched.
+    const authLabel = headline.slice(prefix.length);
+    if (authLabel.length === 0 || authLabel.includes(" · ")) continue;
+    const translated = t(headline);
+    return translated.includes(authLabel) ? translated : headline;
+  }
+  return headline;
+}
