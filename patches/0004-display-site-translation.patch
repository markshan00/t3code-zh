+  const t = globalThis.__t3zh?.t;
+  if (!t) return text;
+  const direct = t(text);
+  if (direct !== text && !direct.includes(terminology.singular)) return direct;
+  const term = t(terminology.singular);
+  if (term === terminology.singular) return direct;
+  // Replace the term at its translated positions only, never inside `preserve`.
+  // Function form: a `$` in the translated term would otherwise be a replacement
+  // pattern.
+  const replaced =
