diff --git a/apps/web/src/connectionPermissionDisplayStrings.ts b/apps/web/src/connectionPermissionDisplayStrings.ts
new file mode 100644
index 0000000..2f95275
--- /dev/null
+++ b/apps/web/src/connectionPermissionDisplayStrings.ts
@@ -0,0 +1,16 @@
+/** Known UI permission failures only; arbitrary provider/server errors stay unchanged. */
+const PERMISSION_ERRORS: readonly string[] = [
+  "This connection cannot change threads.",
+  "This connection cannot search host files.",
+  "This connection cannot read host files.",
+  "This connection cannot upload attachments.",
+  "This connection cannot import projects or thread history.",
+  "This connection cannot browse host folders.",
+  "This connection cannot change keyboard shortcuts.",
+];
+const permissionErrors = new Set(PERMISSION_ERRORS);
+
+export function displayConnectionPermissionError<T extends string | null | undefined>(value: T): T {
+  if (typeof value !== "string" || !permissionErrors.has(value)) return value;
+  return (globalThis.__t3zh?.t?.(value) ?? value) as T;
+}
