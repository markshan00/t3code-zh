     }
   }, [canScrollCollapseComposer, setIsComposerScrollCollapsed]);
 
+  // Scroll gestures collapse the composer from inside wheel/keydown
+  // dispatch. Committing React state there blocks the in-flight scroll frame
+  // behind a full composer re-render plus the FLIP measurement, which reads
+  // as a stutter mid-gesture. Defer the commit to the next frame and mark it
+  // interruptible so the scroll always wins the main thread.
+  const scheduleScrollCollapse = useCallback(() => {
+    if (composerScrollCollapseFrameRef.current !== null) return;
+    composerScrollCollapseFrameRef.current = window.requestAnimationFrame(() => {
+      composerScrollCollapseFrameRef.current = null;
+      // An expand, eligibility change, or return to the live edge may have
+      // landed since scheduling.
+      if (!composerScrollCollapseEligibleRef.current || isTimelineAtLogicalEnd()) return;
+      startTransition(() => setIsComposerScrollCollapsed(true));
+    });
+  }, [isTimelineAtLogicalEnd, setIsComposerScrollCollapsed]);
+  const cancelScheduledScrollCollapse = useCallback(() => {
+    if (composerScrollCollapseFrameRef.current === null) return;
+    window.cancelAnimationFrame(composerScrollCollapseFrameRef.current);
+    composerScrollCollapseFrameRef.current = null;
+  }, []);
+
   // Returning to the window re-fires focus on the element that already held
   // it. That focus arrives after the window's own event, so a window focus
   // marks the frame in which it should be ignored by the form's capture.
