diff --git a/apps/desktop/src/preload.ts b/apps/desktop/src/preload.ts
index a97f224a1b414144b5e07923bb979adc4d407a07..3aaa4739614e77f2f150aebc7fab2609c000ec6f 100644
--- a/apps/desktop/src/preload.ts
+++ b/apps/desktop/src/preload.ts
@@ -43,6 +43,25 @@ try {
   // Best effort: the app still starts on the V2 profile's own storage.
 }
 
+// t3code-zh：主进程把 app.getPreferredSystemLanguages() 经主窗口 webPreferences.additionalArguments 传进来
+// （t3zh/t3zh-desktop.ts 的 systemLanguagesArgument），这里暴露给 web 运行时（CONVENTIONS §5 语言来源第 1 级）。
+// oxlint-disable-next-line t3code/no-global-process-runtime -- additionalArguments 只能从 process.argv 读取。
+const t3zhSystemLanguagesArgument = process.argv.find((arg) =>
+  arg.startsWith("--t3zh-system-languages="),
+);
+if (t3zhSystemLanguagesArgument !== undefined) {
+  try {
+    const languages: unknown = JSON.parse(
+      t3zhSystemLanguagesArgument.slice("--t3zh-system-languages=".length),
+    );
+    if (Array.isArray(languages) && languages.every((item) => typeof item === "string")) {
+      contextBridge.exposeInMainWorld("__t3zhSystemLanguages", languages);
+    }
+  } catch {
+    // 参数不是合法 JSON 时不暴露，web 运行时退回 §5 的第 2 级来源。
+  }
+}
+
 // oxlint-disable-next-line t3code/no-global-process-runtime -- Electron exposes the client platform in its sandboxed preload process.
 const clientPlatform = process.platform;
 
