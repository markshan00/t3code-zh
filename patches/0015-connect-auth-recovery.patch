# The maintainer explicitly authorized this functional recovery fix on 2026-10-07.
# Baseline: v0.0.46-nightly.20261007.2774 / 611132c171f3a821bd2e32f22261135cef6330ac
# Keep T3 Connect loading/failure visible and offer a manual renderer reload.
# Does not change auth sessions, scopes, account state or SDK dependencies.
diff --git a/apps/web/src/components/clerk/T3ConnectSidebarSignIn.behavior.test.tsx b/apps/web/src/components/clerk/T3ConnectSidebarSignIn.behavior.test.tsx
new file mode 100644
