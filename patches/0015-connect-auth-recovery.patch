+function T3ConnectAuthRecovery({ loading = false }: { readonly loading?: boolean }) {
+  const [timedOut, setTimedOut] = useState(false);
+
+  useEffect(() => {
+    if (!loading) return;
+    const timer = window.setTimeout(() => setTimedOut(true), 15_000);
+    return () => window.clearTimeout(timer);
+  }, [loading]);
+
+  const canReload = !loading || timedOut;
+
+  return (
+    <SidebarMenu>
+      <SidebarMenuItem>
+        <div className="space-y-2 px-2 py-1">
+          <p className="text-sm font-medium">T3 Connect</p>
+          <p role="status" className="text-xs text-sidebar-muted-foreground">
+            {loading
+              ? timedOut
+                ? "T3 Connect is taking longer than expected."
+                : "Connecting to T3 Connect…"
+              : "T3 Connect could not load."}
+          </p>
+          {canReload && (
+            <>
+              <Button variant="outline" size="sm" onClick={() => window.location.reload()}>
+                <RotateCwIcon />
+                <span>Reload app</span>
+              </Button>
+              <p className="text-xs text-sidebar-muted-foreground">
+                Save any unfinished input before reloading.
+              </p>
+            </>
+          )}
+        </div>
+      </SidebarMenuItem>
+    </SidebarMenu>
+  );
+}
