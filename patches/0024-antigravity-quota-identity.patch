 describe("Antigravity subscription limits", () => {
+  it.effect("uses Hub platform names for Windows and Linux quota requests", () =>
+    Effect.gen(function* () {
+      for (const options of [
+        {
+          platform: "win32",
+          architecture: "x64",
+          expectedUserAgent: "antigravity/hub/2.9.1 windows/amd64",
+        },
+        {
+          platform: "linux",
+          architecture: "x64",
+          expectedUserAgent: "antigravity/hub/2.9.1 linux/amd64",
+        },
+      ] as const) {
+        const { probe } = yield* fixture(options);
+        expect((yield* probe).windows).toHaveLength(4);
+      }
+    }).pipe(Effect.scoped, Effect.provide(NodeServices.layer)),
+  );
+
+  it.effect("omits rolling reset placeholders for unused buckets but keeps measured resets", () =>
+    Effect.gen(function* () {
+      const now = yield* DateTime.now;
+      const resetAfter = (minutes: number) => DateTime.formatIso(DateTime.add(now, { minutes }));
+      const { probe } = yield* fixture({
+        summary: {
+          buckets: [
+            {
+              bucketId: "gemini-weekly",
+              window: "weekly",
+              remainingFraction: 0.97561556,
+              resetTime: resetAfter(10080),
+            },
+            {
+              bucketId: "gemini-5h",
+              window: "5h",
+              remainingFraction: 0.9033314,
+              resetTime: resetAfter(266),
+            },
+            {
+              bucketId: "3p-weekly",
+              window: "weekly",
+              remainingFraction: 1,
+              resetTime: resetAfter(10080),
+            },
+            { bucketId: "3p-5h", window: "5h", remainingFraction: 1, resetTime: resetAfter(300) },
+            {
+              bucketId: "active-full",
+              window: "5h",
+              remainingFraction: 1,
+              resetTime: resetAfter(200),
+            },
+            {
+              bucketId: "described-full",
+              window: "5h",
+              remainingFraction: 1,
+              resetTime: resetAfter(300),
+              description: "Resets in 5 hours.",
+            },
+          ],
+        },
+      });
+      const limits = yield* probe;
+      const byId = new Map(limits.windows.map((window) => [window.id, window]));
+      expect(byId.get("gemini-weekly")?.usedPercent).toBeCloseTo(2.438444);
+      expect(byId.get("gemini-weekly")?.resetsAt).toBe(resetAfter(10080));
+      expect(byId.get("gemini-5h")?.usedPercent).toBeCloseTo(9.66686);
+      expect(byId.get("gemini-5h")?.resetsAt).toBe(resetAfter(266));
+      for (const id of ["3p-weekly", "3p-5h"]) {
+        expect(byId.get(id)?.usedPercent).toBe(0);
+        expect(byId.get(id)?.resetsAt).toBeUndefined();
+      }
+      expect(byId.get("active-full")?.resetsAt).toBe(resetAfter(200));
+      expect(byId.get("described-full")?.resetsAt).toBe(resetAfter(300));
+    }).pipe(Effect.scoped, Effect.provide(NodeServices.layer)),
+  );
+
