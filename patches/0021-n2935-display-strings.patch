diff --git a/apps/web/src/n2935DisplayStrings.ts b/apps/web/src/n2935DisplayStrings.ts
new file mode 100644
index 00000000..47907172
--- /dev/null
+++ b/apps/web/src/n2935DisplayStrings.ts
@@ -0,0 +1,85 @@
+import { fillSlot, translateFixed } from "./newThreadDisplayStrings";
+import { displayRelativeTime } from "./acceptanceDisplayStrings";
+
+// Translate a fixed skeleton, then insert data. The private markers never come from data.
+function fillCleanupSlots(skeleton: string, values: readonly string[]): string {
+  const translated = globalThis.__t3zh?.t?.(skeleton) ?? skeleton;
+  const markers = values.map((_, index) => String.fromCharCode(0xE000 + index));
+  const valid = markers.every((marker) => translated.split(marker).length === 2);
+  const result = valid ? translated : skeleton;
+  return result.split(/([\uE000-\uE002])/).map((part) => {
+    const index = markers.indexOf(part);
+    return index < 0 ? part : values[index];
+  }).join("");
+}
+
+export function displayCleanupLastRun(relative: string, bytes: string, failed: number): string {
+  const failure = failed > 0
+    ? fillSlot(" ", String(failed), failed === 1 ? " item couldn't be removed." : " items couldn't be removed.")
+    : "";
+  return fillCleanupSlots("Last run \uE000. \uE001 recovered.\uE002", [displayRelativeTime(relative), bytes, failure]);
+}
+
+export function displayCleanupSummary(removed: number, kept: number, failed: number): string {
+  return failed > 0
+    ? fillCleanupSlots("\uE000 removed, \uE001 kept, \uE002 failed", [String(removed), String(kept), String(failed)])
+    : fillCleanupSlots("\uE000 removed, \uE001 kept", [String(removed), String(kept)]);
+}
+
+const CLEANUP_REASONS: string[] = [
+  "No rules apply",
+  "Project is unavailable",
+  "Thread is running or has pending work",
+  "Open terminal",
+  "Worktree is a symbolic link",
+  "Outside the managed worktree folder",
+  "Contains a project checkout",
+  "Not a linked worktree",
+  "Repository or branch changed",
+  "Default branch is unavailable",
+  "Thread was deleted",
+  "No commits beyond the default branch",
+  "Provider session is still open",
+  "Repository or branch changed since check",
+  "Commit changed since check",
+  "Settings changed since check",
+  "Local changes exceed the inspection limit",
+  "Ignored files exceed the inspection limit",
+  "No expired files"
+];
+const cleanupReasons = new Set(CLEANUP_REASONS);
+export function displayCleanupReason(value: string): string {
+  if (value === "Open terminal") {
+    const translated = translateFixed("Cleanup reason: Open terminal");
+    return translated === "Cleanup reason: Open terminal" ? value : translated;
+  }
+  return cleanupReasons.has(value) ? translateFixed(value) : value;
+}
+
+// English/no runtime uses dnd-kit's defaults. Chinese changes only spoken display text.
+export function panelDragAccessibility(label: (id: string | number) => string) {
+  if (globalThis.__t3zh?.getResolvedLocale?.() !== "zh-CN") return undefined;
+  type Active = { active: { id: string | number } };
+  type Over = Active & { over: { id: string | number } | null };
+  return {
+    screenReaderInstructions: { draggable: translateFixed("\n    To pick up a draggable item, press the space bar.\n    While dragging, use the arrow keys to move the item.\n    Press space again to drop the item in its new position, or press escape to cancel.\n  ") },
+    announcements: {
+      onDragStart({ active }: Active) {
+        return fillSlot("Picked up draggable item ", label(active.id), ".");
+      },
+      onDragOver({ active, over }: Over) {
+        return over
+          ? fillCleanupSlots("Draggable item \uE000 was moved over droppable area \uE001.", [label(active.id), label(over.id)])
+          : fillSlot("Draggable item ", label(active.id), " is no longer over a droppable area.");
+      },
+      onDragEnd({ active, over }: Over) {
+        return over
+          ? fillCleanupSlots("Draggable item \uE000 was dropped over droppable area \uE001", [label(active.id), label(over.id)])
+          : fillSlot("Draggable item ", label(active.id), " was dropped.");
+      },
+      onDragCancel({ active }: Active) {
+        return fillSlot("Dragging was cancelled. Draggable item ", label(active.id), " was dropped.");
+      },
+    },
+  };
+}
