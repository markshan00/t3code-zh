     to: "/settings/general",
     searchTerms: ["notification toast popup completion input approval failure"],
   },
+  {
+    id: "language",
+    title: "Language",
+    to: "/settings/general",
+    searchTerms: ["locale interface app translation chinese english system"],
+  },
   {
     id: "time-format",
     title: "Time format",
diff --git a/apps/web/src/vite-env.d.ts b/apps/web/src/vite-env.d.ts
index 31260c8ae666fcb7814d8e078f4dac4a930a0f6d..d3ecb559241378d1a6108873d2f2934377a14e2e 100644
--- a/apps/web/src/vite-env.d.ts
+++ b/apps/web/src/vite-env.d.ts
@@ -23,5 +23,11 @@ interface ImportMeta {
 declare global {
   interface Window {
     desktopBridge?: DesktopBridge;
+    /** Injected by the zh-CN runtime (patches/0001-language-setting.patch). */
+    __t3zh?: {
+      getLocale(): "system" | "en" | "zh-CN";
+      getResolvedLocale(): "en" | "zh-CN";
+      setLocale(value: "system" | "en" | "zh-CN"): void;
+    };
   }
 }
