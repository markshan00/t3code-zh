+  "and",
+  "just now",
+];
+const knownLabels = new Set(ACCEPTANCE_DISPLAY_LABELS);
+export function displayKnown<T>(value: T): T {
+  return (typeof value === "string" && knownLabels.has(value) ? translateFixed(value) : value) as T;
+}
+export function displayCount(count: number, singular: string, plural: string, formattedCount = String(count)): string {
+  return fillSlot("", formattedCount, ` ${count === 1 ? singular : plural}`);
+}
+export function displayDuration(value: string): string {
+  // Only the formatter's numeric units, never free text. Existing Chinese stays unchanged.
+  if (!/^\d+(?:\.\d+)?(?:ms|s|m|h|d)(?: \d+(?:\.\d+)?(?:ms|s|m|h|d))*$/.test(value))
+    return displayKnown(value);
+  return value.replace(/(\d+(?:\.\d+)?)(ms|s|m|h|d)/g, (_whole, n, unit) => fillSlot("", n, unit));
+}
+export function displayCheckedParts(suffix: string | null | undefined): readonly [string, string] {
+  if (suffix && suffix !== "ago") return ["Checked ", ` ${suffix}`];
+  return translateAroundSlot("Checked ", suffix ? " ago" : "");
+}
+export function displayRelativeTime(value: string): string {
+  if (value.endsWith(" ago")) {
+    const duration = value.slice(0, -4);
+    if (/^\d+(?:\.\d+)?[smhd]$/.test(duration))
+      return fillSlot("", displayDuration(duration), " ago");
+  }
+  return displayKnown(value);
+}
+export function displayFold(value: string): string {
+  for (const before of ["Worked for ", "Continued for ", "You stopped after "]) {
+    if (value.startsWith(before))
+      return fillSlot(before, displayDuration(value.slice(before.length)), "");
+  }
+  return displayKnown(value);
+}
+export function displayWorkSummary(value: string): string {
+  // This specific built-in aggregate has no paths, commands or user-supplied names.
+  const part = String.raw`(?:已运行 \d+ 条命令|已更改 \d+ 个文件|Ran \d+ commands?|Changed \d+ files?)`;
+  if (new RegExp(`^${part} and ${part}$`).test(value))
+    return value.replace(" and ", ` ${displayKnown("and")} `);
+  return value;
+}
+export function displayScope(value: string): string {
+  const turn = /^Turn (\d+|\?)$/.exec(value);
+  return turn ? fillSlot("Turn ", turn[1]!, "") : displayKnown(value);
+}
+export function displayFailedTool(value: string): string {
+  return fillSlot("", value, ", tool call failed");
+}
+export function displayTerminalAction(value: string): string {
+  for (const prefix of [
+    "Split Terminal Horizontally",
+    "Split Terminal Vertically",
+    "New Terminal",
+    "Close Terminal",
+  ]) {
+    if (value === prefix) return displayKnown(prefix);
+    if (value.startsWith(`${prefix} (`) && value.endsWith(")"))
+      return displayKnown(prefix) + value.slice(prefix.length);
+  }
+  return value;
+}
+export function displayOpenIn(value: string): string {
+  return value.startsWith("Open in ") ? fillSlot("Open in ", value.slice(8), "") : value;
+}
+export function displayFollowUp(modifier: string, shortcut: string): string {
+  const intro = displayKnown("Queue follow-ups while the agent runs or steer the current run.");
+  if (shortcut === "mod-enter-multiline") {
+    // Two occurrences use an exact dedicated skeleton; insert modifier after translation.
+    const slot = "\uE000";
+    const sentence = `Press ${slot} + Enter for single-line prompts or ${slot} + Shift + Enter for multiline prompts to do the opposite for one message.`;
+    return intro + " " + (globalThis.__t3zh?.t?.(sentence) ?? sentence).split(slot).join(modifier);
+  }
+  return (
+    intro +
+    " " +
+    fillSlot(
+      "Press ",
+      modifier + (shortcut === "mod-enter" ? " + Shift" : ""),
+      " + Enter to do the opposite for one message.",
+    )
+  );
+}
