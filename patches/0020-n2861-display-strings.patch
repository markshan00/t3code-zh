diff --git a/apps/web/src/n2861DisplayStrings.ts b/apps/web/src/n2861DisplayStrings.ts
new file mode 100644
index 00000000..1046b367
--- /dev/null
+++ b/apps/web/src/n2861DisplayStrings.ts
@@ -0,0 +1,18 @@
+import { translateAroundSlot, translateFixed } from "./newThreadDisplayStrings";
+
+// Keep the file React element and insert the arbitrary host only after translation.
+export function downloadAroundFile(host: string): [string, string] {
+  const [before, after] = translateAroundSlot("", " from \uE001 was downloaded instead.");
+  if ((before + after).split("\uE001").length !== 2) {
+    return ["", ` from ${host} was downloaded instead.`];
+  }
+  return [before.replace("\uE001", () => host), after.replace("\uE001", () => host)];
+}
+
+/** Context-specific code language labels; language IDs and stored info strings stay intact. */
+export function displayComposerCodeLanguage(language: string, label: string): string {
+  if (globalThis.__t3zh?.getResolvedLocale?.() !== "zh-CN") return label;
+  if (language === "") return translateFixed("Code language name: Plain text");
+  if (language === "diff") return "Diff";
+  return label;
+}
