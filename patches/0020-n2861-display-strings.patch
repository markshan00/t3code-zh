diff --git a/apps/web/src/diffSearchDisplayStrings.ts b/apps/web/src/diffSearchDisplayStrings.ts
new file mode 100644
index 00000000..c040b91a
--- /dev/null
+++ b/apps/web/src/diffSearchDisplayStrings.ts
@@ -0,0 +1,66 @@
+import { fillSlot, translateFixed } from "./newThreadDisplayStrings";
+
+const labels: Record<string, string> = {
+  "Search": "Search",
+  "Replace": "Replace",
+  "Match Case": "Match case",
+  "Whole Word": "Match whole word",
+  "Regexp": "Use regular expression",
+  "Replace All": "Replace all",
+  "Previous": "Previous match",
+  "Next": "Next match",
+  "Close": "Close find",
+};
+
+/** Only Pierre's numeric result labels; arbitrary content is never translated. */
+export function displayDiffSearchCount(value: string): string {
+  if (value === "No results") return translateFixed("No results");
+  const total = /^(\d+) results$/.exec(value);
+  if (total) return fillSlot("", total[1]!, " results");
+  const current = /^(\d+) of (\d+)$/.exec(value);
+  if (current) return translateFixed("\uE000 of \uE001")
+    .replace("\uE000", current[1]!)
+    .replace("\uE001", current[2]!);
+  return value;
+}
+
+/** Scope to the viewer's dedicated search host, excluding file text and input values. */
+export function observeDiffSearchLabels(container: HTMLElement): () => void {
+  if (globalThis.__t3zh?.getResolvedLocale() !== "zh-CN") return () => {};
+  const panels = new Map<HTMLElement, MutationObserver>();
+  const update = (root: ShadowRoot) => {
+    const panel = root.querySelector("[data-search-panel]");
+    if (!panel) return;
+    for (const element of panel.querySelectorAll("input, button")) {
+      for (const attribute of ["placeholder", "title", "aria-label"]) {
+        const original = element.getAttribute(attribute);
+        if (original === null || !Object.hasOwn(labels, original)) continue;
+        const translated = translateFixed(labels[original]!);
+        if (translated !== original) element.setAttribute(attribute, translated);
+      }
+    }
+    const counter = panel.querySelector("[data-matches]");
+    if (counter?.textContent) {
+      const translated = displayDiffSearchCount(counter.textContent);
+      if (translated !== counter.textContent) counter.textContent = translated;
+    }
+  };
+  const discover = () => {
+    for (const [host, observer] of panels) {
+      if (!container.contains(host)) { observer.disconnect(); panels.delete(host); }
+    }
+    for (const host of container.querySelectorAll<HTMLElement>("[data-diffs-search]")) {
+      if (!host.shadowRoot || panels.has(host)) continue;
+      const root = host.shadowRoot;
+      const observer = new MutationObserver(() => update(root));
+      panels.set(host, observer);
+      observer.observe(root, { subtree: true, childList: true, characterData: true,
+        attributes: true, attributeFilter: ["placeholder", "title", "aria-label"] });
+      update(root);
+    }
+  };
+  const observer = new MutationObserver(discover);
+  observer.observe(container, { subtree: true, childList: true });
+  discover();
+  return () => { observer.disconnect(); for (const child of panels.values()) child.disconnect(); panels.clear(); };
+}
