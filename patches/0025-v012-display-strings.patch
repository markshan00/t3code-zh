diff --git a/apps/web/src/v012DisplayStrings.ts b/apps/web/src/v012DisplayStrings.ts
new file mode 100644
index 00000000..1c9ae902
--- /dev/null
+++ b/apps/web/src/v012DisplayStrings.ts
@@ -0,0 +1,44 @@
+// Finite v0.1.2 display labels only; provider details and user text remain raw.
+export const V012_DISPLAY_LABELS: readonly string[] = [
+  "Why am I being asked this?",
+  "App access approval",
+  "Command approval",
+  "File read approval",
+  "App permission approval",
+  "File change approval",
+  "App access request",
+  "Command",
+  "File to read",
+  "Permission request",
+  "File change",
+  "Approve",
+  "Decline",
+  "Cancel",
+  "Always allow this session",
+  "Allow once",
+  "Allow for this thread",
+  "Deny",
+  "Allow all edits this session",
+  "Always allow",
+  "Mixed",
+  "Full access skips approvals, but an ask rule in the agent's own settings matches this action, so it still asks. Remove or narrow that rule to stop these prompts.",
+  "Full access skips approvals, but the agent still stops for a few safety checks of its own that no setting can skip, such as a delete whose path it can't verify. T3 Code can't turn these off, so check the request and approve it if it's what you expect."
+];
+const knownLabels = new Set(V012_DISPLAY_LABELS);
+export function displayV012Label<T>(value: T): T | string {
+  if (typeof value !== "string" || !knownLabels.has(value)) return value;
+  return globalThis.__t3zh?.t?.(value) ?? value;
+}
+
+// "Show code" also means a pairing code elsewhere. Keep this view's wording scoped.
+// The values are dictionary keys, translated at render time; skip the plugin's E2 mapping rule.
+const mermaidToggleLabels: Readonly<Record<string, string>> = {
+  "Show code": /* t3zh-skip */ "Mermaid: Show code",
+  "Show diagram": /* t3zh-skip */ "Mermaid: Show diagram",
+};
+export function displayMermaidToggle(value: string): string {
+  if (!Object.hasOwn(mermaidToggleLabels, value)) return value;
+  const key = mermaidToggleLabels[value]!;
+  const translated = globalThis.__t3zh?.t?.(key) ?? key;
+  return translated === key ? value : translated;
+}
