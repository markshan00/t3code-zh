diff --git a/apps/web/src/desktopIpcStrings.ts b/apps/web/src/desktopIpcStrings.ts
new file mode 100644
index 0000000000000000000000000000000000000000..de5660388a1914790b8a2606ed4f77b201f523bd
--- /dev/null
+++ b/apps/web/src/desktopIpcStrings.ts
@@ -0,0 +1,94 @@
+/**
+ * t3code-zh（patches/0006）：桌面主进程经 IPC 传给 web、在界面上显示的英文。
+ *
+ * 只有下面列出的精确文字才交给 `globalThis.__t3zh?.t?.()` 查表，其余原样返回。这些显示位置还会收到
+ * 任意英文（截图失败时的 error.message、服务器返回的报错等），而运行时的模板匹配用在任意英文上会误配
+ * （例如 `{head} to {base}` 会把 "Failed to …" 拆成半中半英），所以不能对任意文字调用 t()。
+ * 词条在 dict/zh-CN.json；名单出处见 reports/desktop-main-strings.md 第 4 节，
+ * plugin/__tests__/desktop-ipc-strings.test.ts 核对名单里的文字仍在上游源码中、且都有精确词条。
+ *
+ * 只用在显示处：比较、存储、去重、作为键的代码继续用原值（SnapShotSetupDialog 的 details 就先用英文原值去重、
+ * 用英文原值当 React key，只在 <p> 的正文调用本函数）。名单写成普通数组再传给 Set，不写成
+ * `new Set([...字面量])`——转换插件的预扫描会把那种写法的元素记为值用途，影响别处同名文字的翻译。
+ */
+
+// 连接设置的端点名（apps/desktop/src/backend/DesktopServerExposure.ts；Tailscale 两项是产品名，不译）。
+const ENDPOINT_NAMES: readonly string[] = [
+  "This machine",
+  "Local network",
+  "Custom HTTPS",
+  "Custom endpoint",
+];
+
+// 截图：macOS 权限提示与快捷键检测（apps/desktop/src/snapShot/DesktopSnapShot.ts、snapShot.ts）。
+const SNAP_SHOT_MESSAGES: readonly string[] = [
+  "Allow Screen Recording in System Settings, then restart T3 Code.",
+  "Allow Accessibility in System Settings, then restart T3 Code.",
+  "Allow Accessibility and Screen Recording in System Settings, then restart T3 Code.",
+  "This shortcut is already used by the system or another app.",
+  "The system could not register this shortcut.",
+  "Shift combinations are used for typing and text selection. Add another modifier.",
+  "This shortcut controls running commands in terminals.",
+  "The system uses Alt+Tab to switch apps.",
+  "The system already uses this shortcut.",
+];
+// snapShot.ts 的 COMMON_MOD_ACTIONS：`This shortcut is ${action} in most apps.`
+const SNAP_SHOT_COMMON_ACTIONS: readonly string[] = [
+  "Select All",
+  "Copy",
+  "Find",
+  "New",
+  "Open",
+  "Print",
+  "Quit",
+  "Save",
+  "New Tab",
+  "Paste",
+  "Close Window",
+  "Cut",
+  "Undo",
+];
+// packages/contracts/src/settings.ts 的 APPLE_MODIFIER_LABELS：`${label} + ${label} is not available on this system.`
+const SNAP_SHOT_APPLE_MODIFIERS: readonly string[] = ["Shift", "Command", "Control", "Option"];
+
+// 桌面版远程更新失败的原因（apps/desktop/src/updates/remoteUpdateFlow.ts、DesktopRemoteUpdates.ts、
+// DesktopUpdates.ts），经服务端的 ServerSelfUpdateError 变成 `Server update failed: ${reason}` 后显示。
+const DESKTOP_UPDATE_FAILURE_REASONS: readonly string[] = [
+  "Automatic updates are disabled on this machine.",
+  "Automatic updates are not available because no update feed is configured.",
+  "Automatic updates are only available in packaged production builds.",
+  "Automatic updates are disabled by the T3CODE_DISABLE_AUTO_UPDATE setting.",
+  "Automatic updates on Linux require the AppImage or the .deb package.",
+  "The desktop app failed to download the update.",
+  "The desktop app update failed.",
+  "The desktop app did not report an update result.",
+  "The desktop app failed to install the update.",
+  "A prepared desktop update is already in progress.",
+  "The desktop app lost the downloaded update.",
+  "This desktop update is no longer prepared.",
+  "The desktop app could not start the install.",
+];
+
+const KNOWN_DESKTOP_IPC_STRINGS: ReadonlySet<string> = new Set(
+  ENDPOINT_NAMES.concat(
+    SNAP_SHOT_MESSAGES,
+    SNAP_SHOT_COMMON_ACTIONS.map((action) => `This shortcut is ${action} in most apps.`),
+    SNAP_SHOT_APPLE_MODIFIERS.map(
+      (modifier) => `${modifier} + ${modifier} is not available on this system.`,
+    ),
+    DESKTOP_UPDATE_FAILURE_REASONS.map((reason) => `Server update failed: ${reason}`),
+  ),
+);
+
+/** 名单里的文字查表翻译，其余（含 null / undefined）原样返回。 */
+export function translateKnownDesktopString(value: string): string;
+export function translateKnownDesktopString(value: string | null): string | null;
+export function translateKnownDesktopString(
+  value: string | null | undefined,
+): string | null | undefined;
+export function translateKnownDesktopString(
+  value: string | null | undefined,
+): string | null | undefined {
+  if (typeof value !== "string" || !KNOWN_DESKTOP_IPC_STRINGS.has(value)) return value;
+  return globalThis.__t3zh?.t?.(value) ?? value;
+}
