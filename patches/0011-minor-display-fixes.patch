# 0011-minor-display-fixes.patch
# Baseline v0.1.9, apply after 0001–0010 (zh.5).
# Small display fixes found while reviewing zh.4; display boundaries only.
#   * Sidebar row accessible name: the status part (Goal / Working / Waiting / Approval /
#     Input / Limited / Failed / Woke / Done) and the draft row's "Unsent draft" go through
#     the exact allowlist. topStatus.label itself stays English for sorting and icons.
#   * Provider banner dismiss button: one fixed skeleton per ServerProviderState
#     (ready / warning / error); the provider name is inserted after translation and
#     unknown states keep the original English sentence.
#   * Tool group summary "commands + changed files": dedicated two-slot skeletons replace
#     the generic "and" lookup; anything else (tool, integration or user names) is unchanged.
# Dictionary-only wording changes in the same release: "Checked {0}", the follow-up
# shortcut sentence. Tests: plugin/__tests__/acceptance-display-strings.test.ts.
diff --git a/apps/web/src/acceptanceDisplayStrings.ts b/apps/web/src/acceptanceDisplayStrings.ts
index 9ea3c6de..d9d98024 100644
--- a/apps/web/src/acceptanceDisplayStrings.ts
+++ b/apps/web/src/acceptanceDisplayStrings.ts
@@ -177,8 +177,17 @@ export const ACCEPTANCE_DISPLAY_LABELS: string[] = [
   "Clone Bitbucket workspace/repository",
   "Forgejo / Gitea repository",
   "Clone Forgejo / Gitea owner/repo",
-  "and",
   "just now",
+  // Sidebar row status labels (SidebarThreadRow topStatus) and the draft row status.
+  "Goal",
+  "Working",
+  "Waiting",
+  "Approval",
+  "Input",
+  "Limited",
+  "Woke",
+  "Done",
+  "Unsent draft",
 ];
 const knownLabels = new Set(ACCEPTANCE_DISPLAY_LABELS);
 export function displayKnown<T>(value: T): T {
@@ -191,6 +200,14 @@ export function displayLiveCommand(verb: string, program: string): string {
 export function displayProviderTitle(providerName: string): string {
   return fillSlot("", providerName, " provider status");
 }
+// The banner's status is a ServerProviderState; each value has its own fixed skeleton.
+// Unknown future states keep the original English sentence.
+const DISMISS_PROVIDER_STATES: string[] = ["ready", "warning", "error"];
+const dismissProviderStates = new Set(DISMISS_PROVIDER_STATES);
+export function displayDismissProvider(providerName: string, state: string): string {
+  if (!dismissProviderStates.has(state)) return `Dismiss ${providerName} provider ${state}`;
+  return fillSlot("Dismiss ", providerName, ` provider ${state}`);
+}
 export function displayCount(count: number, singular: string, plural: string, formattedCount = String(count)): string {
   return fillSlot("", formattedCount, ` ${count === 1 ? singular : plural}`);
 }
@@ -220,11 +237,28 @@ export function displayFold(value: string): string {
   return displayKnown(value);
 }
 export function displayWorkSummary(value: string): string {
-  // This specific built-in aggregate has no paths, commands or user-supplied names.
-  const part = String.raw`(?:已运行 \d+ 条命令|已更改 \d+ 个文件|Ran \d+ commands?|Changed \d+ files?)`;
-  if (new RegExp(`^${part} and ${part}$`).test(value))
-    return value.replace(" and ", ` ${displayKnown("and")} `);
-  return value;
+  // Only the built-in "commands + changed files" aggregate: both halves must be exact
+  // counters, so tool, integration and user-supplied names never match. The counts are
+  // inserted after translating a dedicated two-slot skeleton.
+  const commands = String.raw`(?:已运行 (\d+) 条命令|[Rr]an (\d+) commands?)`;
+  const files = String.raw`(?:已更改 (\d+) 个文件|[Cc]hanged (\d+) files?)`;
+  const commandsFirst = new RegExp(`^${commands} and ${files}$`).exec(value);
+  const filesFirst = commandsFirst ? null : new RegExp(`^${files} and ${commands}$`).exec(value);
+  const match = commandsFirst ?? filesFirst;
+  if (!match) return value;
+  const first = "";
+  const second = "";
+  const skeleton = commandsFirst
+    ? `Ran ${first} commands and changed ${second} files`
+    : `Changed ${first} files and ran ${second} commands`;
+  const translated = globalThis.__t3zh?.t?.(skeleton) ?? skeleton;
+  if (
+    translated === skeleton ||
+    translated.split(first).length !== 2 ||
+    translated.split(second).length !== 2
+  )
+    return value;
+  return translated.replace(first, match[1] ?? match[2]!).replace(second, match[3] ?? match[4]!);
 }
 export function displayScope(value: string): string {
   const turn = /^Turn (\d+|\?)$/.exec(value);
