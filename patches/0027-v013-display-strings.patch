+++ b/apps/web/src/v013DisplayStrings.ts
@@ -0,0 +1,13 @@
+/**
+ * t3code-zh（patches/0027）：v0.1.3 的显示补译，只在最终渲染处调用。
+ *
+ * snoozeWakeLabel（client-runtime）的返回值现在同时被 useThreadLifecycle 当值比较（`!== "now"`）
+ * 并插进 `Snoozed, ${snoozeWake} left`，所以补丁让它保持英文；侧栏暂缓行原样显示同一个值，
+ * 在这里按固定形态（`now` 或「数字 + m/h/d」）交给词库，其余文字原样返回。
+ */
+const SNOOZE_WAKE_SHAPE = /^(?:now|[1-9]\d*[mhd])$/;
+
+export function displaySnoozeWake(value: string): string {
+  if (!SNOOZE_WAKE_SHAPE.test(value)) return value;
+  return globalThis.__t3zh?.t?.(value) ?? value;
+}
