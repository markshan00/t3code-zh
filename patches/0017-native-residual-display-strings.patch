+export const TRAIT_CONTEXT_LABELS: string[] = ["Max", "Ultra"];
+export const TRAIT_CONTEXT_KEYS: string[] = ["Reasoning tier: Max", "Reasoning tier: Ultra"];
+export function displayTraitLabel(value: string): string {
+  const key = TRAIT_CONTEXT_KEYS[TRAIT_CONTEXT_LABELS.indexOf(value)];
+  if (key) {
+    const translated = translateFixed(key);
+    return translated === key ? value : translated;
+  }
+  return traitLabels.has(value) ? translateFixed(value) : displayKnown(value);
+}
 const knownLabels = new Set(ACCEPTANCE_DISPLAY_LABELS);
 export function displayKnown<T>(value: T): T {
