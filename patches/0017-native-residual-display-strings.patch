+/** Running send tooltip: only the two audited directions; shortcut is inserted after translation. */
+export function displayRunningSendTooltip(
+  value: string | null | undefined,
+  followUpBehavior: string,
+  alternateAction: string,
+  shortcut: string | null | undefined,
+): string | null | undefined {
+  if (
+    !(
+      (followUpBehavior === "steer" && alternateAction === "queue") ||
+      (followUpBehavior === "queue" && alternateAction === "steer")
+    )
+  )
+    return displayKnown(value);
+  const expected = `Click to ${followUpBehavior}, Ctrl/⌘-click${shortcut ? ` or ${shortcut}` : ""} to ${alternateAction}`;
+  if (value !== expected) return displayKnown(value);
+  if (!shortcut) return translateFixed(expected);
+  return fillSlot(
+    `Click to ${followUpBehavior}, Ctrl/⌘-click or `,
+    shortcut,
+    ` to ${alternateAction}`,
+  );
+}
+
+/** Two-slot display skeletons: dynamic values never enter t(). */
+export function displayOlderComments(count: number, hidden: number): string {
+  const skeleton =
+    hidden === 1
+      ? "Show \uE000 older comment (\uE001 hidden)"
+      : "Show \uE000 older comments (\uE001 hidden)";
+  return translateFixed(skeleton)
+    .replace("\uE000", String(count))
+    .replace("\uE001", String(hidden));
+}
+export function displayDeviceStepAria(
+  step: string,
+  index: number,
+  summary: string | null | undefined,
+): string {
+  return translateFixed(summary ? "\uE000, step \uE001, \uE002" : "\uE000, step \uE001")
+    .replace("\uE000", () => displayKnown(step))
+    .replace("\uE001", String(index + 1))
+    .replace("\uE002", () => summary ?? "");
+}
