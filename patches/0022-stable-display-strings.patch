@@ -0,0 +1,50 @@
+import { fillSlot, translateFixed } from "./newThreadDisplayStrings";
+
+// Only fixed display skeletons enter the translator; values are inserted afterwards.
+export function displayParts<T>(skeleton: string, values: readonly T[]): Array<string | T> {
+  const translated = globalThis.__t3zh?.t?.(skeleton) ?? skeleton;
+  const markers = values.map((_, index) => String.fromCharCode(0xE000 + index));
+  const valid = markers.every((marker) => translated.split(marker).length === 2);
+  return (valid ? translated : skeleton).split(/([\uE000-\uE00F])/).map((part) => {
+    const index = markers.indexOf(part);
+    return index < 0 ? part : values[index]!;
+  });
+}
+
+export function fillDisplaySlots(skeleton: string, values: readonly (string | number)[]): string {
+  return displayParts(skeleton, values).join("");
+}
+
+const WORKFLOW_STATUS = ["running", "failed", "stopped", "done", "not started", "completed", "pending", "waiting", "downloading", "restarting", "updating providers", "idle", "cancelled", "interrupted"];
+export function displayWorkflowStatus(value: string): string {
+  return WORKFLOW_STATUS.includes(value) ? translateFixed(value) : value;
+}
+
+// stopSubline is an upstream UI formatter. Its fixed label / numeric outputs are exhaustive.
+export function displayGuideSubline(value: string): string {
+  if (value === "Context, no code") return translateFixed("Context, no code");
+  const match = /^(\d+) (file|files)$/.exec(value);
+  return match ? fillSlot("", match[1]!, ` ${match[2]}`) : value;
+}
+
+export function displayUpdateMachineFailure(name: string): string {
+  const skeleton = "Update machine failed: \uE000";
+  const translated = translateFixed(skeleton);
+  return translated === skeleton ? `${name} failed` : translated.replace("\uE000", () => name);
+}
+
+export function displayMergeMethod(method: string): string {
+  if (globalThis.__t3zh?.getResolvedLocale() !== "zh-CN") return method;
+  switch (method) {
+    case "merge": return translateFixed("Merge");
+    case "squash": return translateFixed("Squash and merge");
+    case "rebase": return translateFixed("Rebase");
+    default: return method;
+  }
+}
+
+export function displayUpdateStatus(value: string): string {
+  const match = /^(downloading|Downloading)( \d+%)?$/.exec(value);
+  if (match) return translateFixed(match[1]!) + (match[2] ?? "");
+  return displayWorkflowStatus(value);
+}
